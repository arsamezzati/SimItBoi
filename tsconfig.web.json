{
  "compilerOptions": {
    "composite": true, "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true, "allowImportingTsExtensions": true,
    "baseUrl": ".", "paths": { "@core/*": ["src/core/*"] }
  },
  "include": ["src/renderer/**/*", "src/core/**/*"]
}
