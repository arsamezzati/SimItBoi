# Blizzard Game Data API credentials.
#
# BUILD-TIME ONLY. These generate the static item metadata table.
# They are never bundled into the app and are never needed to run SimItBoi.
#
# Get them at: https://develop.battle.net/access/clients
#   - Client name: anything (e.g. "SimItBoi")
#   - Redirect URI: http://localhost
#
# Paste values directly after the "=" — no quotes, no spaces.
# This file is gitignored and will not be committed.

BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Region for the API host. Item data is identical across regions.
BLIZZARD_REGION=eu
